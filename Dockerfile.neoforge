# MC 1.21.1 richiede Java 21 (MC >= 1.20.5). NON tornare a java17: il server non parte.
FROM ghcr.io/itzg/minecraft-server:2025.3.0-java21-graalvm
#
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
#
ENV TYPE=NEOFORGE
ENV SERVER_NAME=BonoCraft
# Default dell'immagine itzg = 1G, insufficiente per 84 mod + Cobblemon.
# Sovrascrivibile a runtime con -e MEMORY=...
ENV MEMORY=6G
# I flag G1 di Aikar, gestiti dall'immagine.
ENV USE_AIKAR_FLAGS=true
ENV EULA=TRUE
ENV VERSION=1.21.1
COPY mods_neoforge /data/mods/
ADD https://cdn.modrinth.com/data/MdwFAVRL/versions/eLcb8xod/Cobblemon-neoforge-1.6.1%2B1.21.1.jar  /data/mods/Cobblemon-neoforge-1.6.1%2B1.21.1.jar
#
ENTRYPOINT ["/start"]
#
